    q_planck_time [shape=ellipse,label="planck-time"];
    j_CE_planck_time -> q_planck_time;
    j_CE_rydberg_energy [shape=box,style="filled",fillcolor="#cfe3f7",color="#3a6ea5",label="Rydberg energy"];
    q_rydberg_energy [shape=ellipse,label="rydberg-energy"];
    j_CE_rydberg_energy -> q_rydberg_energy;
  }
}
